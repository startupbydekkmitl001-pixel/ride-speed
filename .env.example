# Client-safe configuration (publishable key is not a service credential)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only: enter in Supabase Edge Function Secrets, never EXPO_PUBLIC_*
# GEOAPIFY_API_KEY=YOUR_GEOAPIFY_PROJECT_KEY
# ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082

# OpenFreeMap basemap needs no account/key.
# Apple identity, SMTP and push credentials are configured with providers/server.
